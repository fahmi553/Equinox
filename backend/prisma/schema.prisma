generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FAMILY
  GUEST
  CHILD
}

model User {
  id                       String        @id @default(cuid())
  username                 String        @unique
  displayName              String
  passwordHash             String
  role                     Role          @default(FAMILY)
  canUploadFiles           Boolean?
  canCreateFolders         Boolean?
  canCreateNotes           Boolean?
  canCreateReminders       Boolean?
  canCreateTasks           Boolean?
  canCreateTags            Boolean?
  canCreateBookmarks       Boolean?
  canUseChat               Boolean?
  canCreateDocumentRecords Boolean?
  canViewAnnouncements     Boolean?
  createdAt                DateTime      @default(now())
  notes                    Note[]
  reminders                Reminder[]
  tasks                    Task[]
  tags                     Tag[]
  bookmarks                Bookmark[]
  documentRecords DocumentRecord[]
  announcements Announcement[]
  sentChatMessages ChatMessage[] @relation("SentChatMessages")
  receivedChatMessages ChatMessage[] @relation("ReceivedChatMessages")
  notifications Notification[]
  adapterFileMetadata AdapterFileMetadata[]
  adapterFileSharesReceived AdapterFileShare[] @relation("AdapterFileShareRecipient")
  passwordResetTokens PasswordResetToken[]
  sessions UserSession[]
  files        FileAsset[]
  folders      Folder[]
  activityLogs ActivityLog[]
  preference   UserPreference?
}

model RolePermission {
  role                     Role     @id
  canUploadFiles           Boolean  @default(true)
  canCreateFolders         Boolean  @default(true)
  canCreateNotes           Boolean  @default(true)
  canCreateReminders       Boolean  @default(true)
  canCreateTasks           Boolean  @default(true)
  canCreateTags            Boolean  @default(true)
  canCreateBookmarks       Boolean  @default(true)
  canUseChat               Boolean  @default(true)
  canCreateDocumentRecords Boolean  @default(true)
  canViewAnnouncements     Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

model ModuleSetting {
  key         String   @id
  isEnabled   Boolean  @default(true)
  healthState String   @default("available")
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model IntegrationSetting {
  key         String   @id
  label       String
  adapterType String
  isEnabled   Boolean  @default(false)
  healthState String   @default("planned")
  config      Json?
  updatedAt   DateTime @updatedAt
}

model UserPreference {
  userId      String   @id
  startPage   String   @default("/dashboard")
  compactMode Boolean  @default(false)
  dateFormat  String   @default("locale")
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  title     String
  body      String
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tags      Tag[]
}

model Reminder {
  id          String    @id @default(cuid())
  title       String
  dueAt       DateTime?
  isShared    Boolean   @default(false)
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Tag {
  id        String      @id @default(cuid())
  name      String
  color     String      @default("#7c3aed")
  isShared  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  ownerId   String
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  notes     Note[]
  tasks     Task[]
  files     FileAsset[]
  adapterFileMetadata AdapterFileMetadata[]
  bookmarks Bookmark[]

  @@unique([ownerId, name])
}

model Bookmark {
  id        String   @id @default(cuid())
  title     String
  url       String
  notes     String   @default("")
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tags      Tag[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  details     String    @default("")
  priority    String    @default("NORMAL")
  status      String    @default("OPEN")
  dueAt       DateTime?
  isShared    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tags        Tag[]
}

model FileAsset {
  id           String   @id @default(cuid())
  originalName String
  storedName   String
  mimeType     String
  size         Int
  path         String
  isShared     Boolean  @default(false)
  isImportant  Boolean  @default(false)
  uploadedAt   DateTime @default(now())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  documentRecords DocumentRecord[]
  tags         Tag[]
}

model AdapterFileMetadata {
  id          String   @id @default(cuid())
  adapterKey  String
  path        String
  name        String
  size        Int?
  isImportant Boolean  @default(false)
  isShared    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tags        Tag[]
  userShares  AdapterFileShare[]
  publicLinks PublicFileShareLink[]

  @@unique([adapterKey, path, ownerId])
  @@index([adapterKey, path])
  @@index([ownerId, isImportant, updatedAt])
  @@index([isShared, updatedAt])
}

model AdapterFileShare {
  id         String              @id @default(cuid())
  metadataId String
  metadata   AdapterFileMetadata @relation(fields: [metadataId], references: [id], onDelete: Cascade)
  userId     String
  user       User                @relation("AdapterFileShareRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())

  @@unique([metadataId, userId])
  @@index([userId, createdAt])
}

model PublicFileShareLink {
  id          String              @id @default(cuid())
  metadataId  String
  metadata    AdapterFileMetadata @relation(fields: [metadataId], references: [id], onDelete: Cascade)
  tokenHash   String              @unique
  label       String              @default("")
  expiresAt   DateTime
  isRevoked   Boolean             @default(false)
  downloadCount Int               @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([metadataId, isRevoked])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt, expiresAt])
}

model UserSession {
  id          String    @id @default(cuid())
  tokenId     String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress   String    @default("unknown")
  userAgent   String    @default("unknown")
  rememberMe  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([userId, revokedAt, expiresAt])
}

model DocumentRecord {
  id        String    @id @default(cuid())
  title     String
  category  String    @default("GENERAL")
  status    String    @default("OPEN")
  amount    Float?
  notes     String    @default("")
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fileId    String?
  file      FileAsset? @relation(fields: [fileId], references: [id], onDelete: SetNull)
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  isPinned  Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id          String   @id @default(cuid())
  body        String
  createdAt   DateTime @default(now())
  authorId    String
  author      User     @relation("SentChatMessages", fields: [authorId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   User?    @relation("ReceivedChatMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  body      String
  link      String?
  sourceId  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([type, sourceId])
}

model Folder {
  id        String      @id @default(cuid())
  name      String
  isShared  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  ownerId   String
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Folder?     @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]    @relation("FolderChildren")
  files     FileAsset[]

  @@unique([ownerId, parentId, name])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
